{
  "name": "modern-tools-list-meta",
  "description": "Direct modern tools/list with per-request _meta returns resultType complete, the tool catalog, cache hints, and result _meta serverInfo. Frozen per platform because tool descriptions are platform-specific.",
  "steps": [
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 101,
        "method": "tools/list",
        "params": {
          "_meta": {
            "io.modelcontextprotocol/protocolVersion": "2026-07-28",
            "io.modelcontextprotocol/clientCapabilities": {},
            "io.modelcontextprotocol/clientInfo": {
              "name": "probe",
              "version": "0"
            }
          }
        }
      },
      "expect": {
        "id": 101,
        "result": {
          "_meta": {
            "io.modelcontextprotocol/serverInfo": {
              "name": "open-computer-use",
              "version": "<VERSION>"
            }
          },
          "cacheScope": "public",
          "ttlMs": 300000,
          "tools": [
            {
              "inputSchema": {
                "type": "object",
                "properties": {
                  "element_index": {
                    "type": "string",
                    "description": "Element index to click"
                  },
                  "x": {
                    "type": "number",
                    "description": "X coordinate in screenshot pixel coordinates"
                  },
                  "click_count": {
                    "description": "Number of clicks. Defaults to 1",
                    "type": "integer"
                  },
                  "y": {
                    "type": "number",
                    "description": "Y coordinate in screenshot pixel coordinates"
                  },
                  "app": {
                    "type": "string",
                    "description": "App name or bundle identifier"
                  },
                  "mouse_button": {
                    "enum": [
                      "left",
                      "right",
                      "middle"
                    ],
                    "description": "Mouse button to click. Defaults to left.",
                    "type": "string"
                  },
                  "snapshot_ref": {
                    "description": "Snapshot reference returned by the immediately preceding get_app_state or action result for this app.",
                    "type": "string"
                  },
                  "click_method": {
                    "enum": [
                      "auto",
                      "accessibility",
                      "app_post",
                      "sky_click",
                      "global"
                    ],
                    "description": "Click implementation: auto (default), accessibility, app_post, sky_click, or global. Accessibility requires element_index. app_post sends a public event directly to the target app. sky_click uses the macOS SkyLight background window path. Global may move the system pointer and requires OPEN_COMPUTER_USE_ALLOW_GLOBAL_POINTER_FALLBACKS=1.",
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "app",
                  "snapshot_ref"
                ]
              },
              "name": "click",
              "description": "Click an element by index or pixel coordinates from screenshot. This tool is part of plugin `Computer Use`.",
              "annotations": {
                "openWorldHint": false,
                "destructiveHint": false
              }
            },
            {
              "annotations": {
                "destructiveHint": false,
                "openWorldHint": false
              },
              "name": "drag",
              "inputSchema": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "app",
                  "from_x",
                  "from_y",
                  "to_x",
                  "to_y",
                  "snapshot_ref"
                ],
                "properties": {
                  "from_y": {
                    "type": "number",
                    "description": "Start Y coordinate"
                  },
                  "snapshot_ref": {
                    "type": "string",
                    "description": "Snapshot reference returned by the immediately preceding get_app_state or action result for this app."
                  },
                  "to_x": {
                    "type": "number",
                    "description": "End X coordinate"
                  },
                  "from_x": {
                    "description": "Start X coordinate",
                    "type": "number"
                  },
                  "to_y": {
                    "description": "End Y coordinate",
                    "type": "number"
                  },
                  "app": {
                    "description": "App name or bundle identifier",
                    "type": "string"
                  }
                }
              },
              "description": "Drag from one point to another using pixel coordinates. This tool is part of plugin `Computer Use`."
            },
            {
              "name": "get_app_state",
              "inputSchema": {
                "required": [
                  "app"
                ],
                "additionalProperties": false,
                "properties": {
                  "text_limit": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "enum": [
                          "max"
                        ],
                        "type": "string"
                      }
                    ],
                    "description": "Maximum text characters to return. Use \"max\" for full text. Defaults to 500."
                  },
                  "app": {
                    "description": "App name or bundle identifier",
                    "type": "string"
                  },
                  "max_tree_nodes": {
                    "minimum": 1,
                    "description": "Maximum accessibility tree nodes to render. Defaults to 1200.",
                    "type": "integer"
                  },
                  "max_tree_depth": {
                    "description": "Maximum accessibility tree depth to render. Defaults to 64.",
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "type": "object"
              },
              "description": "Start an app use session if needed, then get the state of the app's key window and return a screenshot and accessibility tree. The result includes a snapshot_ref that every action tool for this app requires; each action result returns a successor snapshot_ref to thread into the next call. This must be called once per assistant turn before interacting with the app. This tool is part of plugin `Computer Use`.",
              "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
              }
            },
            {
              "name": "list_apps",
              "description": "List the apps on this computer. Returns the set of apps that are currently running, as well as any that have been used in the last 14 days, including details on usage frequency. Call get_app_state next to capture a window and obtain the snapshot_ref that action tools require. This tool is part of plugin `Computer Use`.",
              "inputSchema": {
                "properties": {},
                "additionalProperties": false,
                "type": "object"
              },
              "annotations": {
                "openWorldHint": false,
                "readOnlyHint": true,
                "idempotentHint": true,
                "destructiveHint": false
              }
            },
            {
              "inputSchema": {
                "type": "object",
                "required": [
                  "app",
                  "element_index",
                  "action",
                  "snapshot_ref"
                ],
                "additionalProperties": false,
                "properties": {
                  "action": {
                    "type": "string",
                    "description": "Secondary accessibility action name"
                  },
                  "element_index": {
                    "type": "string",
                    "description": "Element identifier"
                  },
                  "app": {
                    "description": "App name or bundle identifier",
                    "type": "string"
                  },
                  "snapshot_ref": {
                    "type": "string",
                    "description": "Snapshot reference returned by the immediately preceding get_app_state or action result for this app."
                  }
                }
              },
              "name": "perform_secondary_action",
              "annotations": {
                "destructiveHint": false,
                "openWorldHint": false
              },
              "description": "Invoke a secondary accessibility action exposed by an element. This tool is part of plugin `Computer Use`."
            },
            {
              "inputSchema": {
                "required": [
                  "app",
                  "key",
                  "snapshot_ref"
                ],
                "additionalProperties": false,
                "type": "object",
                "properties": {
                  "key": {
                    "description": "Key or key combination to press",
                    "type": "string"
                  },
                  "snapshot_ref": {
                    "description": "Snapshot reference returned by the immediately preceding get_app_state or action result for this app.",
                    "type": "string"
                  },
                  "app": {
                    "description": "App name or bundle identifier",
                    "type": "string"
                  }
                }
              },
              "name": "press_key",
              "description": "Press a key or key-combination on the keyboard, including modifier and navigation keys.\n  - This supports xdotool's `key` syntax.\n  - Examples: \"a\", \"Return\", \"Tab\", \"super+c\", \"Up\", \"KP_0\" (for the numpad 0 key). This tool is part of plugin `Computer Use`.",
              "annotations": {
                "destructiveHint": false,
                "openWorldHint": false
              }
            },
            {
              "name": "scroll",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "app": {
                    "description": "App name or bundle identifier",
                    "type": "string"
                  },
                  "direction": {
                    "type": "string",
                    "description": "Scroll direction: up, down, left, or right"
                  },
                  "element_index": {
                    "description": "Element identifier",
                    "type": "string"
                  },
                  "pages": {
                    "description": "Number of pages to scroll. Fractional values are supported. Defaults to 1",
                    "type": "number"
                  },
                  "snapshot_ref": {
                    "description": "Snapshot reference returned by the immediately preceding get_app_state or action result for this app.",
                    "type": "string"
                  }
                },
                "required": [
                  "app",
                  "element_index",
                  "direction",
                  "snapshot_ref"
                ],
                "additionalProperties": false
              },
              "annotations": {
                "destructiveHint": false,
                "openWorldHint": false
              },
              "description": "Scroll an element in a direction by a number of pages. This tool is part of plugin `Computer Use`."
            },
            {
              "description": "Set the value of a settable accessibility element. This tool is part of plugin `Computer Use`.",
              "inputSchema": {
                "type": "object",
                "required": [
                  "app",
                  "element_index",
                  "value",
                  "snapshot_ref"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "description": "Value to assign"
                  },
                  "element_index": {
                    "type": "string",
                    "description": "Element identifier"
                  },
                  "app": {
                    "description": "App name or bundle identifier",
                    "type": "string"
                  },
                  "snapshot_ref": {
                    "description": "Snapshot reference returned by the immediately preceding get_app_state or action result for this app.",
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "annotations": {
                "destructiveHint": false,
                "openWorldHint": false
              },
              "name": "set_value"
            },
            {
              "inputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "app",
                  "text",
                  "snapshot_ref"
                ],
                "properties": {
                  "app": {
                    "description": "App name or bundle identifier",
                    "type": "string"
                  },
                  "text": {
                    "type": "string",
                    "description": "Literal text to type"
                  },
                  "snapshot_ref": {
                    "description": "Snapshot reference returned by the immediately preceding get_app_state or action result for this app.",
                    "type": "string"
                  }
                }
              },
              "description": "Type literal text using keyboard input. This tool is part of plugin `Computer Use`.",
              "name": "type_text",
              "annotations": {
                "destructiveHint": false,
                "openWorldHint": false
              }
            }
          ],
          "resultType": "complete"
        },
        "jsonrpc": "2.0"
      }
    }
  ]
}
